# Python virtual environment
.venv/

# Python cache
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store

# Ignore all data folders anywhere
data/

# Ignore data generation code
dataGenerationCode/

# Ignore all saves folders anywhere
saves/

# Ignore HDF5 / H5 data files
*.hdf5
*.h5
*.json

# Ignore images for now
*.md
*.pdf

# Ignore model checkpoints (any size)
*.pt
*.pth
*.ckpt
*.safetensors

# Ignore NPZ data; re-include only the small histogram artifacts (~KB each).
# gitignore cannot filter by size, so this is the pattern-level approximation
# of "no NPZ larger than ~10 MB": the large ones stay ignored.
*.npz
!**/mass_histograms.npz

# Ignore archives and run logs
*.zip
*.log
runs/
wandb/
logs/

# outputs: upload plots (PNG), keep models, NPZ, caches, metrics and reports out
outputs/*
!outputs/**/
outputs/**/.plot_cache/
outputs/**/*.csv
outputs/**/*.txt
outputs/**/*.md

# Provenance references are small JSON that MUST be in version control; the
# blanket *.json rule above would otherwise silently drop them, which defeats
# the point of a reproduction reference (see docs/mg5_vm_runbook.md).
!scripts/prior_build/reference/*.json

# MG5 / Pythia8 generation artifacts. The toolchain and its output live on the
# generation VM's local disk, never in the repo or on the shared folder.
*.lhe
*.lhe.gz
MG5_aMC*/
mg5work/
Events/
.slide-build
docs
deliverables