\newlabel{fig:upsilon}{{4}{11}{\textbf {Zero-shot transfer to the $\Upsilon $ family.} Decoded spectra on the continuum-reweighted evaluation prior against CMS data for three frozen-kernel checkpoints; the lower panel is the ratio to the data. Peak positions agree, the widths do not. \textnormal {[measured]}}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Systematics budget.} Left: per-state medians on the raw and continuum-reweighted evaluation priors against the $\pm 30$ MeV band. Right: the same quantity across three subsample seeds (the bootstrap floor is 0.4 MeV). The third axis - the choice of checkpoint - spans 85-92 MeV. \textnormal  {[measured]}}}{11}{figure.5}\protected@file@percent }
\newlabel{fig:systematics}{{5}{11}{\textbf {Systematics budget.} Left: per-state medians on the raw and continuum-reweighted evaluation priors against the $\pm 30$ MeV band. Right: the same quantity across three subsample seeds (the bootstrap floor is 0.4 MeV). The third axis - the choice of checkpoint - spans 85-92 MeV. \textnormal {[measured]}}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Per-event unfolding.} Left: residual rms relative to the identity map on the paired benchmark; the oracle is fitted on the pairing and is a ceiling, not a method. Right: pull standard deviation and $1\sigma $ coverage against their nominal values; the deterministic stage-1 encoder has a zero-variance posterior. \textnormal  {[measured]}}}{12}{figure.6}\protected@file@percent }
\newlabel{fig:inverse}{{6}{12}{\textbf {Per-event unfolding.} Left: residual rms relative to the identity map on the paired benchmark; the oracle is fitted on the pairing and is a ceiling, not a method. Right: pull standard deviation and $1\sigma $ coverage against their nominal values; the deterministic stage-1 encoder has a zero-variance posterior. \textnormal {[measured]}}{figure.6}{}}
