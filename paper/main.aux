\newlabel{fig:indomain}{{1}{9}{\textbf {In-domain closure of the accepted shared model.} $x$-space mass density ratio for Run E (selected checkpoint): $J/\psi $ (top) and $Z$ (bottom). Solid: CMS data; dotted: the data cycle $x\to \tilde z\to \tilde x$; dashed: the decoded prior $z\to \tilde x^{\prime }$; the lower panel of each pair is the ratio to the data. \textnormal {[measured]}}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {The late $\Upsilon $ shift is not noise.} Decoded $\Upsilon $ peak position against the inference-time tail-noise multiplier, for healthy checkpoints and for the broken one; the broken checkpoint shows the full shift with the tail noise switched off. \textnormal  {[measured]}}}{10}{figure.2}\protected@file@percent }
\newlabel{fig:peakshift}{{2}{10}{\textbf {The late $\Upsilon $ shift is not noise.} Decoded $\Upsilon $ peak position against the inference-time tail-noise multiplier, for healthy checkpoints and for the broken one; the broken checkpoint shows the full shift with the tail noise switched off. \textnormal {[measured]}}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Identification scorecard.} Top: intra-event width over the required resolution for every retained checkpoint of the Run E to Run H arms (band 0.8-1.25; degenerate below 0.5). Bottom: per-slice $W_1$ over its finite-sample floor at native noise. \textnormal  {[measured]}}}{10}{figure.3}\protected@file@percent }
\newlabel{fig:scorecard}{{3}{10}{\textbf {Identification scorecard.} Top: intra-event width over the required resolution for every retained checkpoint of the Run E to Run H arms (band 0.8-1.25; degenerate below 0.5). Bottom: per-slice $W_1$ over its finite-sample floor at native noise. \textnormal {[measured]}}{figure.3}{}}
